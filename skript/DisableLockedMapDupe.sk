# =====================================================================
#  DisableLockedMapDupe.sk
# ---------------------------------------------------------------------
#  Stops players from CLONING / DUPING *locked* map art.
#
#  - Locked maps  (run through a cartography table with a glass pane)
#    can NOT be copied in the cartography table or the crafting table.
#  - Normal, non-locked maps clone exactly like vanilla - untouched.
#
#  Why reflect?  A map's "locked" flag is NOT stored on the item / NBT,
#  it lives on the map DATA and is only reachable through the Bukkit API
#  MapView#isLocked(). SkBee's NBT tools can't see it, so we read it with
#  skript-reflect.
#
#  Requires: skript-reflect   https://github.com/SkriptLang/skript-reflect
#  Tested on: Paper 1.20.x - 1.21.x
#
#  Staff bypass permission:  quicklogin.maps.dupebypass
# =====================================================================

import:
    org.bukkit.inventory.meta.MapMeta
    org.bukkit.map.MapView

# True only when the item is a filled map whose map data is locked.
function isLockedMap(i: item) :: boolean:
    if {_i} is not set:
        return false
    set {_meta} to {_i}.getItemMeta()
    if {_meta} is not set:
        return false
    if {_meta} is not an instance of MapMeta:
        return false
    set {_view} to {_meta}.getMapView()
    if {_view} is not set:
        return false
    return {_view}.isLocked()


# ---------------------------------------------------------------------
#  CARTOGRAPHY TABLE
#  slot 0 = source map | slot 1 = material | slot 2 = result (copy)
#  The dupe happens the moment the copy is pulled from slot 2, so we
#  only need to guard that one slot.
# ---------------------------------------------------------------------
on inventory click:
    "%event-inventory.getType()%" is "CARTOGRAPHY"
    # only the output/result slot matters
    set {_raw} to event.getRawSlot()
    {_raw} is 2
    # there is actually a copy sitting in the output
    event-inventory.getItem(2) is set
    # ...and the source map is locked
    isLockedMap(event-inventory.getItem(0)) is true
    # staff may still copy locked art
    player does not have permission "quicklogin.maps.dupebypass"
    cancel event
    send action bar "&c&lLocked map art can't be copied." to player


# ---------------------------------------------------------------------
#  CRAFTING TABLE  (same dupe vector: filled map + empty maps = clones)
#  Blocked if any ingredient in the grid is a locked map.
# ---------------------------------------------------------------------
on craft:
    set {_grid::*} to event-inventory.getMatrix()
    set {_locked} to false
    loop {_grid::*}:
        if isLockedMap(loop-value) is true:
            set {_locked} to true
    {_locked} is true
    player does not have permission "quicklogin.maps.dupebypass"
    cancel event
    send action bar "&c&lLocked map art can't be copied." to player

# =====================================================================
#  DisableLockedMapDupe.sk
# ---------------------------------------------------------------------
#  Stops players from CLONING / DUPING *locked* map art.
#
#  - Locked maps  (run through a cartography table with a glass pane)
#    can NOT be copied in the cartography table or the crafting table.
#  - Normal, non-locked maps clone exactly like vanilla - untouched.
#
#  How it blocks the cartography table:
#    We listen to PrepareInventoryResultEvent and NULL the output the
#    moment the source map is locked, so no copy is ever generated -
#    there is nothing in the result slot to take. This is far more
#    reliable than cancelling the click on the result slot.
#
#  A map's "locked" flag is NOT on the item / NBT - it lives on the map
#  DATA and is only reachable via Bukkit's MapView#isLocked(), so this
#  uses skript-reflect.
#
#  REQUIRES: skript-reflect  https://github.com/SkriptLang/skript-reflect
#  Tested on: Paper 1.20.x - 1.21.x
#  Diagnostic:  /maptest  (hold a map to see its locked state)
# =====================================================================

options:
    bypass-perm: quicklogin.maps.dupebypass

import:
    org.bukkit.inventory.meta.MapMeta
    org.bukkit.event.inventory.PrepareInventoryResultEvent

# Returns the MapView of a filled map, or nothing for anything else.
# A failed guard makes the function return nothing (treated as "not a map").
function mapViewOf(i: item) :: object:
    {_i} is set
    set {_meta} to {_i}.getItemMeta()
    {_meta} is set
    {_meta} is an instance of MapMeta
    return {_meta}.getMapView()

# True only when the item is a filled map whose map data is locked.
# Compared as text to dodge any boolean auto-conversion quirks.
function isLockedMap(i: item) :: boolean:
    set {_view} to mapViewOf({_i})
    {_view} is set
    "%{_view}.isLocked()%" is "true"
    return true


# ---------------------------------------------------------------------
#  CARTOGRAPHY TABLE - primary block.
#  Fires whenever the result is (re)calculated. If the source map
#  (slot 0) is locked, wipe the result so no copy can be produced.
# ---------------------------------------------------------------------
on PrepareInventoryResultEvent:
    set {_inv} to event.getInventory()
    "%{_inv}.getType()%" is "CARTOGRAPHY"
    isLockedMap({_inv}.getItem(0)) is true
    # {_null} is intentionally unset -> passes Java null -> clears the result
    event.setResult({_null})


# ---------------------------------------------------------------------
#  CARTOGRAPHY TABLE - backup block (in case the result still appears).
#  Uses the slot TYPE (RESULT), which is layout-independent.
# ---------------------------------------------------------------------
on inventory click:
    "%event-inventory.getType()%" is "CARTOGRAPHY"
    "%event.getSlotType()%" is "RESULT"
    isLockedMap(event-inventory.getItem(0)) is true
    player doesn't have permission "{@bypass-perm}"
    cancel event
    send action bar "&c&lLocked map art can't be copied." to player


# ---------------------------------------------------------------------
#  CRAFTING TABLE  (filled map + empty maps = clones: same dupe vector)
# ---------------------------------------------------------------------
on craft:
    set {_grid::*} to event-inventory.getMatrix()
    loop {_grid::*}:
        isLockedMap(loop-value) is true
        player doesn't have permission "{@bypass-perm}"
        cancel event
        send action bar "&c&lLocked map art can't be copied." to player
        stop


# ---------------------------------------------------------------------
#  DIAGNOSTIC:  /maptest  - hold a map and run this.
# ---------------------------------------------------------------------
command /maptest:
    permission: {@bypass-perm}
    trigger:
        set {_view} to mapViewOf(player's tool)
        if {_view} is not set:
            send "&eHeld item is not a filled map (no map view found)." to player
            stop
        send "&aMap view found  ->  locked = &f%{_view}.isLocked()%" to player
